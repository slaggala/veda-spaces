                "mode": "managed",
                "type": "aws_iam_role_policy_attachment",
                "name": "runtime",
                "provider_config_key": "aws",
                "expressions": {
                  "policy_arn": {
                    "references": [
                      "aws_iam_policy.runtime.arn",
                      "aws_iam_policy.runtime"
                    ]
                  },
                  "role": {
                    "references": [
                      "aws_iam_role.host.name",
                      "aws_iam_role.host"
                    ]
                  }
