                "expression": {
                  "references": [
                    "aws_iam_instance_profile.host.name",
                    "aws_iam_instance_profile.host"
                  ]
                },
                "description": "Instance profile for AUT-108."
              },
              "role_arn": {
                "expression": {
                  "references": [
                    "aws_iam_role.host.arn",
                    "aws_iam_role.host"
                  ]
