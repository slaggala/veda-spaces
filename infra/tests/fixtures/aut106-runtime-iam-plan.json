          "policy": "{\"Statement\":[{\"Action\":\"ecr:GetAuthorizationToken\",\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"EcrLogin\"},{\"Action\":[\"ecr:BatchGetImage\",\"ecr:GetDownloadUrlForLayer\",\"ecr:BatchCheckLayerAvailability\"],\"Effect\":\"Allow\",\"Resource\":\"arn:aws:ecr:ap-south-1:111122223333:repository/veda-api\",\"Sid\":\"EcrPullVedaApi\"},{\"Action\":[\"s3:GetObject\",\"s3:PutObject\",\"s3:DeleteObject\"],\"Effect\":\"Allow\",\"Resource\":\"arn:aws:s3:::veda-stg-litestream-111122223333/*\",\"Sid\":\"LitestreamReplica\"},{\"Action\":[\"s3:GetObject\",\"s3:GetObjectVersion\",\"s3:PutObject\",\"s3:PutObjectRetention\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:s3:::veda-stg-snapshots-111122223333/*\",\"arn:aws:s3:::veda-stg-anchor-111122223333/*\"],\"Sid\":\"LockedWrites\"},{\"Action\":\"s3:GetObject\",\"Effect\":\"Allow\",\"Resource\":\"arn:aws:s3:::veda-stg-artifacts-111122223333/*\",\"Sid\":\"DeployBundles\"},{\"Action\":\"s3:PutObject\",\"Effect\":\"Allow\",\"Resource\":\"arn:aws:s3:::veda-evidence-111122223333/*\",\"Sid\":\"FileEvidence\"},{\"Action\":[\"s3:ListBucket\",\"s3:GetBucketLocation\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:s3:::veda-stg-litestream-111122223333\",\"arn:aws:s3:::veda-stg-snapshots-111122223333\",\"arn:aws:s3:::veda-stg-anchor-111122223333\",\"arn:aws:s3:::veda-stg-artifacts-111122223333\",\"arn:aws:s3:::veda-evidence-111122223333\"],\"Sid\":\"ListServedBuckets\"},{\"Action\":[\"kms:Decrypt\",\"kms:Encrypt\",\"kms:GenerateDataKey\"],\"Condition\":{\"ForAnyValue:StringEquals\":{\"kms:ResourceAliases\":[\"alias/veda-stg-data\"]}},\"Effect\":\"Allow\",\"Resource\":\"arn:aws:kms:ap-south-1:111122223333:key/*\",\"Sid\":\"DataKey\"},{\"Action\":[\"kms:GenerateDataKey\",\"kms:Encrypt\"],\"Condition\":{\"ForAnyValue:StringEquals\":{\"kms:ResourceAliases\":[\"alias/veda-stg-audit\"]},\"StringEquals\":{\"kms:ViaService\":\"s3.ap-south-1.amazonaws.com\"}},\"Effect\":\"Allow\",\"Resource\":\"arn:aws:kms:ap-south-1:111122223333:key/*\",\"Sid\":\"AuditKeyThroughS3Only\"},{\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\",\"logs:DescribeLogStreams\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:logs:ap-south-1:111122223333:log-group:/veda/staging/*\",\"arn:aws:logs:ap-south-1:111122223333:log-group:/veda/staging/*:*\"],\"Sid\":\"OwnLogGroups\"},{\"Action\":\"logs:DescribeLogGroups\",\"Effect\":\"Allow\",\"Resource\":\"arn:aws:logs:ap-south-1:111122223333:log-group:*\",\"Sid\":\"FindLogGroups\"},{\"Action\":\"cloudwatch:PutMetricData\",\"Condition\":{\"StringLike\":{\"cloudwatch:namespace\":[\"Veda/*\",\"CWAgent\"]}},\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"VedaMetrics\"},{\"Action\":[\"ssm:GetParametersByPath\",\"ssm:GetParameters\",\"ssm:GetParameter\"],\"Effect\":\"Allow\",\"Resource\":[\"arn:aws:ssm:ap-south-1:111122223333:parameter/veda/staging\",\"arn:aws:ssm:ap-south-1:111122223333:parameter/veda/staging/*\"],\"Sid\":\"ReadOwnConfiguration\"},{\"Action\":[\"iam:*\",\"organizations:*\",\"account:*\",\"sts:AssumeRole\",\"sts:AssumeRoleWithWebIdentity\",\"cloudtrail:*\",\"kms:CreateKey\",\"kms:ScheduleKeyDeletion\",\"kms:DisableKey\",\"kms:PutKeyPolicy\",\"kms:CreateGrant\",\"kms:RetireGrant\",\"s3:PutBucket*\",\"s3:DeleteBucket*\",\"s3:PutAccountPublicAccessBlock\",\"s3:PutObjectAcl\",\"s3:PutObjectLegalHold\",\"s3:BypassGovernanceRetention\",\"s3:PutObjectLockConfiguration\",\"s3:PutLifecycleConfiguration\",\"ec2:Run*\",\"ec2:Terminate*\",\"ec2:Modify*\",\"ec2:Create*\",\"ec2:Delete*\",\"ec2:Authorize*\",\"ec2:Revoke*\",\"ec2:Associate*\",\"ec2:Disassociate*\",\"ec2:Attach*\",\"ec2:Detach*\",\"ec2:Replace*\",\"ssm:PutParameter\",\"ssm:DeleteParameter*\",\"ssm:SendCommand\",\"ssm:CreateDocument\",\"ssm:UpdateDocument*\",\"ssm:DeleteDocument\",\"ssm:StartSession\",\"ssm:ResumeSession\",\"logs:DeleteLogGroup\",\"logs:PutRetentionPolicy\",\"logs:DeleteRetentionPolicy\",\"logs:AssociateKmsKey\",\"logs:DisassociateKmsKey\",\"logs:PutMetricFilter\",\"logs:DeleteMetricFilter\",\"ecr:PutImage\",\"ecr:BatchDeleteImage\",\"ecr:InitiateLayerUpload\",\"ecr:UploadLayerPart\",\"ecr:CompleteLayerUpload\",\"ecr:Delete*\",\"ecr:Set*\",\"ecr:Put*\",\"cloudwatch:PutMetricAlarm\",\"cloudwatch:DeleteAlarms\",\"cloudwatch:DisableAlarmActions\",\"cloudwatch:SetAlarmState\",\"sns:*\",\"ses:Create*\",\"ses:Delete*\",\"ses:Put*\",\"ses:Update*\"],\"Effect\":\"Deny\",\"Resource\":\"*\",\"Sid\":\"DenyAdministration\"}],\"Version\":\"2012-10-17\"}",
