                "description": "Host role ARN."
              },
              "role_name": {
                "expression": {
                  "references": [
                    "aws_iam_role.host.name",
                    "aws_iam_role.host"
                  ]
                },
                "description": "Host role."
              }
            },
            "resources": [
              {
                "address": "aws_iam_instance_profile.host",
                "mode": "managed",
                "type": "aws_iam_instance_profile",
                "name": "host",
                "provider_config_key": "aws",
                "expressions": {
                  "name": {
                    "references": [
                      "var.name_prefix"
                    ]
                  },
                  "role": {
                    "references": [
                      "aws_iam_role.host.name",
                      "aws_iam_role.host"
                    ]
                  }
                },
