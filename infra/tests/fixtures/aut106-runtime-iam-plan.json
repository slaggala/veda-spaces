{
  "format_version": "1.2",
  "terraform_version": "1.16.4",
  "variables": {
    "aws_region": {
      "value": "ap-south-1"
    }
  },
  "configuration": {
    "provider_config": {
      "aws": {
        "name": "aws",
        "full_name": "registry.terraform.io/hashicorp/aws",
        "version_constraint": "~> 6.66",
        "expressions": {
          "allowed_account_ids": {
            "references": [
              "local.account_id"
            ]
          },
          "default_tags": [
            {
              "tags": {
                "references": [
                  "local.manifest.repository",
                  "local.manifest"
                ]
              }
            }
          ],
          "region": {
            "references": [
              "var.aws_region"
            ]
          }
        }
      }
    },
    "root_module": {
      "module_calls": {
        "runtime_iam": {
          "source": "../../modules/runtime-iam",
          "expressions": {
            "account_id": {
              "references": [
                "local.account_id"
              ]
            },
            "audit_key_alias": {
              "references": [
                "module.kms.aliases[\"audit\"]",
                "module.kms.aliases",
                "module.kms"
              ]
            },
            "bucket_arns": {
              "references": [
                "module.storage.bucket_arns",
                "module.storage"
              ]
            },
            "data_key_alias": {
              "references": [
                "module.kms.aliases[\"data\"]",
                "module.kms.aliases",
                "module.kms"
              ]
            },
            "log_group_prefix": {
              "references": [
                "local.log_group_prefix"
              ]
            },
            "name_prefix": {
              "references": [
                "local.name_prefix"
              ]
            },
            "parameter_path": {
              "constant_value": "/veda/staging"
            },
            "permissions_boundary_arn": {
              "references": [
                "local.account_id"
              ]
            },
            "region": {
              "references": [
                "var.aws_region"
              ]
            },
            "repository_name": {
              "references": [
                "module.ecr.repository_name",
                "module.ecr"
              ]
            }
          },
