                    "constant_value": "Veda staging host: exact resources it serves, and an explicit deny of administration (AUT-106)"
                  },
                  "name": {
                    "references": [
                      "var.name_prefix"
                    ]
                  },
                  "policy": {
                    "references": [
                      "local.repository_arn",
                      "local.b.litestream",
                      "local.b",
                      "local.b.snapshots",
                      "local.b",
                      "local.b.anchor",
                      "local.b",
                      "local.b.artifacts",
                      "local.b",
                      "local.b.evidence",
                      "local.b",
                      "local.b.litestream",
                      "local.b",
                      "local.b.snapshots",
                      "local.b",
                      "local.b.anchor",
                      "local.b",
                      "local.b.artifacts",
                      "local.b",
                      "local.b.evidence",
                      "local.b",
                      "local.keys_arn",
                      "var.data_key_alias",
                      "local.keys_arn",
                      "var.audit_key_alias",
                      "var.region",
                      "local.logs_arn",
                      "local.logs_arn",
                      "var.region",
                      "var.account_id",
                      "local.param_arn",
                      "local.param_arn",
                      "var.ses_send"
