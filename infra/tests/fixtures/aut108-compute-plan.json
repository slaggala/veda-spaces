{
  "format_version": "1.2",
  "terraform_version": "1.16.4",
  "variables": {
    "aws_region": {
      "value": "ap-south-1"
    }
  },
  "configuration": {
    "provider_config": {
      "aws": {
        "name": "aws",
        "full_name": "registry.terraform.io/hashicorp/aws",
        "version_constraint": "~> 6.66",
        "expressions": {
          "allowed_account_ids": {
            "references": [
              "local.account_id"
            ]
          },
          "default_tags": [
            {
              "tags": {
                "references": [
                  "local.manifest.repository",
                  "local.manifest"
                ]
              }
            }
          ],
          "region": {
            "references": [
              "var.aws_region"
            ]
          }
        }
      }
    },
    "root_module": {
      "module_calls": {
        "compute": {
          "source": "../../modules/compute",
          "expressions": {
            "account_id": {
              "references": [
                "local.account_id"
              ]
            },
            "ami_id": {
              "references": [
                "local.platform.compute.ami_id",
                "local.platform.compute",
                "local.platform"
              ]
            },
            "app_log_group": {
              "references": [
                "module.monitoring.app_log_group",
                "module.monitoring"
              ]
            },
            "data_key_arn": {
              "references": [
                "module.kms.data_key_arn",
                "module.kms"
              ]
            },
            "data_volume_gb": {
              "references": [
                "local.platform.compute.data_volume_gb",
                "local.platform.compute",
                "local.platform"
              ]
            },
            "instance_profile_name": {
              "references": [
                "module.runtime_iam.instance_profile_name",
                "module.runtime_iam"
              ]
            },
            "instance_type": {
              "references": [
                "local.platform.compute.instance_type",
                "local.platform.compute",
                "local.platform"
              ]
            },
            "name_prefix": {
              "references": [
                "local.name_prefix"
              ]
            },
            "permissions_boundary_arn": {
              "references": [
                "local.account_id"
              ]
            },
            "region": {
              "references": [
                "var.aws_region"
              ]
            },
            "root_volume_gb": {
              "references": [
                "local.platform.compute.root_volume_gb",
                "local.platform.compute",
                "local.platform"
              ]
            },
            "security_group_id": {
              "references": [
                "module.network.host_security_group_id",
                "module.network"
              ]
            },
            "snapshot_retain_count": {
              "references": [
                "local.platform.compute.snapshot_retain_count",
                "local.platform.compute",
                "local.platform"
              ]
            },
            "subnet_id": {
              "references": [
                "module.network.public_subnet_id",
                "module.network"
              ]
            }
          },
          "module": {
            "outputs": {
              "ami_id": {
                "expression": {
                  "references": [
                    "local.ami_id"
                  ]
                },
                "description": "The AMI planned (record it in staging-platform.json compute.ami_id after the first plan)."
              },
              "data_device": {
                "expression": {
                  "references": [
                    "aws_volume_attachment.data.device_name",
                    "aws_volume_attachment.data"
                  ]
                },
                "description": "Device name of the data volume attachment (the deploy document mounts it)."
              },
              "data_volume_id": {
                "expression": {
                  "references": [
                    "aws_ebs_volume.data.id",
                    "aws_ebs_volume.data"
                  ]
                },
                "description": "The data volume (/var/lib/veda)."
              },
              "instance_id": {
                "expression": {
                  "references": [
                    "aws_instance.host.id",
                    "aws_instance.host"
                  ]
                },
                "description": "The host."
              }
            },
            "resources": [
              {
                "address": "aws_dlm_lifecycle_policy.data",
                "mode": "managed",
                "type": "aws_dlm_lifecycle_policy",
                "name": "data",
                "provider_config_key": "aws",
                "expressions": {
                  "description": {
                    "constant_value": "Veda staging data volume daily"
                  },
                  "execution_role_arn": {
                    "references": [
                      "aws_iam_role.dlm.arn",
                      "aws_iam_role.dlm"
                    ]
                  },
                  "policy_details": [
                    {
                      "resource_types": {
                        "constant_value": [
                          "VOLUME"
                        ]
                      },
                      "schedule": [
                        {
                          "copy_tags": {
                            "constant_value": true
                          },
                          "create_rule": [
                            {
                              "interval": {
                                "constant_value": 24
                              },
                              "interval_unit": {
                                "constant_value": "HOURS"
                              },
                              "times": {
                                "constant_value": [
                                  "20:30"
                                ]
                              }
                            }
                          ],
                          "name": {
                            "constant_value": "daily"
                          },
                          "retain_rule": [
                            {
                              "count": {
                                "references": [
                                  "var.snapshot_retain_count"
                                ]
                              }
                            }
                          ]
                        }
                      ],
                      "target_tags": {
                        "constant_value": {
                          "veda-backup": "daily"
                        }
                      }
                    }
                  ],
                  "state": {
                    "constant_value": "ENABLED"
                  }
                },
                "schema_version": 0
              },
              {
                "address": "aws_ebs_volume.data",
                "mode": "managed",
                "type": "aws_ebs_volume",
                "name": "data",
                "provider_config_key": "aws",
                "expressions": {
                  "availability_zone": {
                    "references": [
                      "aws_instance.host.availability_zone",
                      "aws_instance.host"
                    ]
                  },
                  "encrypted": {
                    "constant_value": true
                  },
                  "kms_key_id": {
                    "references": [
                      "var.data_key_arn"
                    ]
                  },
                  "size": {
                    "references": [
                      "var.data_volume_gb"
                    ]
                  },
                  "tags": {
                    "references": [
                      "var.name_prefix"
                    ]
                  },
                  "type": {
                    "constant_value": "gp3"
                  }
                },
                "schema_version": 0
              },
              {
                "address": "aws_iam_role.dlm",
                "mode": "managed",
                "type": "aws_iam_role",
                "name": "dlm",
                "provider_config_key": "aws",
                "expressions": {
                  "assume_role_policy": {
                    "references": [
                      "var.account_id"
                    ]
                  },
                  "description": {
                    "constant_value": "Data Lifecycle Manager snapshots of the Veda staging data volume (AUT-108)"
