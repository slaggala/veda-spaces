                      "auto_recovery": {
                        "constant_value": "default"
                      }
                    }
                  ],
                  "metadata_options": [
                    {
                      "http_endpoint": {
                        "constant_value": "enabled"
                      },
                      "http_put_response_hop_limit": {
                        "constant_value": 2
                      },
                      "http_tokens": {
                        "constant_value": "required"
                      },
                      "instance_metadata_tags": {
                        "constant_value": "disabled"
                      }
                    }
                  ],
                  "monitoring": {
                    "constant_value": false
                  },
                  "root_block_device": [
                    {
                      "delete_on_termination": {
                        "constant_value": true
                      },
                      "encrypted": {
                        "constant_value": true
                      },
                      "kms_key_id": {
                        "references": [
                          "var.data_key_arn"
                        ]
                      },
                      "volume_size": {
                        "references": [
                          "var.root_volume_gb"
                        ]
                      },
                      "volume_type": {
                        "constant_value": "gp3"
                      }
                    }
                  ],
                  "subnet_id": {
                    "references": [
                      "var.subnet_id"
                    ]
                  },
                  "tags": {
                    "references": [
                      "var.name_prefix"
                    ]
                  },
                  "user_data": {
                    "references": [
                      "local.user_data"
                    ]
                  },
                  "user_data_replace_on_change": {
                    "constant_value": false
                  },
                  "vpc_security_group_ids": {
                    "references": [
                      "var.security_group_id"
                    ]
                  }
                },
                "schema_version": 2
              },
