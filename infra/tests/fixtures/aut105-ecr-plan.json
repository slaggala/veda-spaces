{
  "format_version": "1.2",
  "terraform_version": "1.16.4",
  "variables": {
    "aws_region": {
      "value": "ap-south-1"
    }
  },
  "configuration": {
    "provider_config": {
      "aws": {
        "name": "aws",
        "full_name": "registry.terraform.io/hashicorp/aws",
        "version_constraint": "~> 6.66",
        "expressions": {
          "allowed_account_ids": {
            "references": [
              "local.account_id"
            ]
          },
          "default_tags": [
            {
              "tags": {
                "references": [
                  "local.manifest.repository",
                  "local.manifest"
                ]
              }
            }
          ],
          "region": {
            "references": [
              "var.aws_region"
            ]
          }
        }
      }
    },
    "root_module": {
      "module_calls": {
        "ecr": {
          "source": "../../modules/ecr",
          "expressions": {
            "data_key_arn": {
              "references": [
                "module.kms.data_key_arn",
                "module.kms"
              ]
            },
            "expire_untagged_days": {
              "references": [
                "local.platform.ecr.expire_untagged_days",
                "local.platform.ecr",
                "local.platform"
              ]
            },
            "keep_tagged_images": {
              "references": [
                "local.platform.ecr.keep_tagged_images",
                "local.platform.ecr",
                "local.platform"
              ]
            },
            "repository_name": {
              "constant_value": "veda-api"
            }
          },
          "module": {
            "outputs": {
              "repository_arn": {
                "expression": {
                  "references": [
                    "aws_ecr_repository.api.arn",
                    "aws_ecr_repository.api"
                  ]
                },
                "description": "Repository ARN (host pull permission, AUT-106)."
              },
              "repository_name": {
                "expression": {
                  "references": [
                    "aws_ecr_repository.api.name",
                    "aws_ecr_repository.api"
                  ]
                },
                "description": "Repository name."
              },
              "repository_url": {
                "expression": {
                  "references": [
                    "aws_ecr_repository.api.repository_url",
                    "aws_ecr_repository.api"
                  ]
                },
                "description": "Registry URL of the repository (the deploy pulls by digest)."
              }
            },
            "resources": [
              {
                "address": "aws_ecr_lifecycle_policy.api",
                "mode": "managed",
                "type": "aws_ecr_lifecycle_policy",
                "name": "api",
                "provider_config_key": "aws",
                "expressions": {
                  "policy": {
                    "references": [
                      "var.expire_untagged_days",
                      "var.keep_tagged_images"
                    ]
                  },
                  "repository": {
                    "references": [
                      "aws_ecr_repository.api.name",
                      "aws_ecr_repository.api"
                    ]
                  }
                },
                "schema_version": 0
              },
              {
                "address": "aws_ecr_repository.api",
                "mode": "managed",
                "type": "aws_ecr_repository",
                "name": "api",
                "provider_config_key": "aws",
                "expressions": {
                  "encryption_configuration": [
                    {
                      "encryption_type": {
                        "constant_value": "KMS"
                      },
                      "kms_key": {
                        "references": [
                          "var.data_key_arn"
                        ]
                      }
                    }
                  ],
                  "force_delete": {
                    "constant_value": false
                  },
                  "image_scanning_configuration": [
                    {
                      "scan_on_push": {
                        "constant_value": true
                      }
                    }
                  ],
                  "image_tag_mutability": {
                    "constant_value": "IMMUTABLE"
                  },
                  "name": {
                    "references": [
                      "var.repository_name"
                    ]
                  }
                },
                "schema_version": 0
              }
            ],
            "variables": {
              "data_key_arn": {
                "description": "AUT-102 data key."
              },
              "expire_untagged_days": {
                "description": "Untagged images expire after this many days."
              },
              "keep_tagged_images": {
                "description": "Tagged images kept (older ones expire)."
              },
              "repository_name": {
                "description": "The application repository; the bootstrap deploy role pushes only to veda-api."
              }
            }
          }
        }
      }
    }
  },
  "resource_changes": [
    {
      "address": "module.ecr.aws_ecr_lifecycle_policy.api",
      "module_address": "module.ecr",
      "mode": "managed",
      "type": "aws_ecr_lifecycle_policy",
      "name": "api",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "before": null,
        "after": {
          "policy": "{\"rules\":[{\"action\":{\"type\":\"expire\"},\"description\":\"Expire untagged images\",\"rulePriority\":1,\"selection\":{\"countNumber\":7,\"countType\":\"sinceImagePushed\",\"countUnit\":\"days\",\"tagStatus\":\"untagged\"}},{\"action\":{\"type\":\"expire\"},\"description\":\"Keep the most recent tagged images\",\"rulePriority\":2,\"selection\":{\"countNumber\":30,\"countType\":\"imageCountMoreThan\",\"tagPatternList\":[\"*\"],\"tagStatus\":\"tagged\"}}]}",
          "region": "ap-south-1",
          "repository": "veda-api"
        },
        "after_unknown": {
          "id": true,
          "registry_id": true
        },
        "before_sensitive": false,
        "after_sensitive": {},
        "after_identity": {
          "account_id": null,
          "region": null,
          "repository": null
        }
      }
    },
    {
      "address": "module.ecr.aws_ecr_repository.api",
      "module_address": "module.ecr",
      "mode": "managed",
      "type": "aws_ecr_repository",
      "name": "api",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "create"
        ],
        "before": null,
        "after": {
          "encryption_configuration": [
            {
              "encryption_type": "KMS"
            }
          ],
          "force_delete": false,
          "image_scanning_configuration": [
            {
              "scan_on_push": true
            }
          ],
          "image_tag_mutability": "IMMUTABLE",
          "image_tag_mutability_exclusion_filter": [],
          "name": "veda-api",
          "region": "ap-south-1",
          "tags": null,
          "tags_all": {
            "env": "staging",
            "managed-by": "terraform",
            "project": "veda-spaces",
            "repository": "example-org/veda-spaces",
            "stack": "core"
          },
          "timeouts": null
        },
        "after_unknown": {
          "arn": true,
          "encryption_configuration": [
            {
              "kms_key": true
            }
          ],
          "id": true,
          "image_scanning_configuration": [
            {}
          ],
          "image_tag_mutability_exclusion_filter": [],
          "registry_id": true,
          "repository_url": true,
          "tags_all": {}
        },
        "before_sensitive": false,
        "after_sensitive": {
          "encryption_configuration": [
            {}
          ],
          "image_scanning_configuration": [
            {}
          ],
          "image_tag_mutability_exclusion_filter": [],
          "tags_all": {}
        },
        "after_identity": {
          "account_id": null,
          "name": null,
          "region": null
        }
      }
    }
  ]
}
