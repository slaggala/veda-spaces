                "local.platform"
              ]
            },
            "instance_profile_name": {
              "references": [
                "module.runtime_iam.instance_profile_name",
                "module.runtime_iam"
              ]
            },
            "instance_type": {
              "references": [
                "local.platform.compute.instance_type",
                "local.platform.compute",
                "local.platform"
              ]
            },
            "name_prefix": {
              "references": [
                "local.name_prefix"
              ]
            },
            "permissions_boundary_arn": {
              "references": [
                "local.account_id"
              ]
            },
            "region": {
              "references": [
                "var.aws_region"
              ]
            },
            "root_volume_gb": {
              "references": [
                "local.platform.compute.root_volume_gb",
                "local.platform.compute",
                "local.platform"
