              "references": [
                "local.platform.ecr.keep_tagged_images",
                "local.platform.ecr",
                "local.platform"
              ]
            },
            "repository_name": {
              "constant_value": "veda-api"
            }
          },
          "module": {
            "outputs": {
              "repository_arn": {
                "expression": {
                  "references": [
                    "aws_ecr_repository.api.arn",
