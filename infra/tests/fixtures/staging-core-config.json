{
  "format_version": "1.2",
  "configuration": {
    "root_module": {
      "module_calls": {
        "budget": {
          "expressions": {
            "alert_email": {
              "references": [
                "var.budget_alert_email"
              ]
            },
            "forecast_alert_thresholds_percent": {
              "references": [
                "local.budget.forecast_alert_thresholds_percent",
                "local.budget"
              ]
            },
            "monthly_limit_usd": {
              "references": [
                "local.budget.monthly_limit_usd",
                "local.budget"
              ]
            },
            "name": {
              "references": [
                "local.budget.name",
                "local.budget"
              ]
            }
          },
          "module": {
            "outputs": {
              "alerts": {
                "expression": {
                  "references": [
                    "aws_budgets_budget.this.notification",
                    "aws_budgets_budget.this"
                  ]
                },
                "description": "Every alert without its recipient (type, comparison, threshold, SNS topics, number of email recipients), ascending by threshold, so the plan text shows what the hidden notification blocks contain."
              },
              "forecast_thresholds_percent": {
                "expression": {
                  "references": [
                    "aws_budgets_budget.this.notification",
                    "aws_budgets_budget.this"
                  ]
                },
                "description": "Forecast alert thresholds, ascending."
              },
              "limit": {
                "expression": {
                  "references": [
                    "aws_budgets_budget.this.limit_amount",
                    "aws_budgets_budget.this",
                    "aws_budgets_budget.this.limit_unit",
                    "aws_budgets_budget.this"
                  ]
                },
                "description": "Monthly limit as AWS stores it (amount and unit)."
              },
              "name": {
                "expression": {
                  "references": [
                    "aws_budgets_budget.this.name",
                    "aws_budgets_budget.this"
                  ]
                },
                "description": "Budget name."
              },
              "notifications": {
                "sensitive": true,
                "expression": {
                  "references": [
                    "aws_budgets_budget.this.notification",
                    "aws_budgets_budget.this"
                  ]
                },
                "description": "The alerts as planned (for the offline tests and the review)."
              }
            },
            "resources": [
              {
                "address": "aws_budgets_budget.this",
                "type": "aws_budgets_budget"
              }
            ]
          }
        },
        "cloudtrail": {
          "expressions": {
            "account_id": {
              "references": [
                "local.account_id"
              ]
            },
            "audit_key_arn": {
              "references": [
                "module.kms.audit_key_arn",
                "module.kms"
              ]
            },
            "log_group_prefix": {
              "references": [
                "local.log_group_prefix"
              ]
            },
            "log_group_retention_days": {
              "references": [
                "local.platform.cloudtrail.log_group_retention_days",
                "local.platform.cloudtrail",
                "local.platform"
              ]
            },
            "logs_bucket_name": {
              "references": [
                "module.storage.bucket_names[\"logs\"]",
                "module.storage.bucket_names",
                "module.storage"
              ]
            },
            "name_prefix": {
              "references": [
                "local.name_prefix"
              ]
            },
            "permissions_boundary_arn": {
              "references": [
                "local.account_id"
              ]
            },
            "region": {
              "references": [
                "var.aws_region"
              ]
            },
            "trail_name": {
              "references": [
                "local.trail_name"
              ]
            }
          },
          "module": {
            "outputs": {
              "log_group_name": {
                "expression": {
                  "references": [
                    "aws_cloudwatch_log_group.trail.name",
                    "aws_cloudwatch_log_group.trail"
                  ]
                },
                "description": "The trail's CloudWatch Logs copy (delivery alarm: AWS/Logs IncomingLogEvents)."
              },
              "tampering_metric": {
                "expression": {
                  "constant_value": {
                    "name": "AuditTampering",
                    "namespace": "Veda/Audit"
                  }
                },
                "description": "Namespace and name of the tampering metric (alarm in AUT-110)."
              },
              "trail_arn": {
                "expression": {
                  "references": [
                    "local.trail_arn"
                  ]
                },
                "description": "The trail."
              }
            },
            "resources": [
              {
                "address": "aws_cloudtrail.this",
                "type": "aws_cloudtrail"
              },
              {
                "address": "aws_cloudwatch_log_group.trail",
                "type": "aws_cloudwatch_log_group"
              },
              {
                "address": "aws_cloudwatch_log_metric_filter.tampering",
                "type": "aws_cloudwatch_log_metric_filter"
              },
              {
                "address": "aws_iam_role.trail_logs",
                "type": "aws_iam_role"
              },
              {
                "address": "aws_iam_role_policy.trail_logs",
                "type": "aws_iam_role_policy"
              }
            ]
          }
        },
