{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeTheOwnerRoleWithMfa",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<OWNER_ROLE_NAME>",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
