{% extends "_layout.v1.jinja" %}
{% block subject %}Break-glass request: {{ action }}{% endblock %}
{% block headline %}A break-glass request was made{% endblock %}
{% block text %}
Hello {{ name }},

A break-glass request ({{ action }}) for {{ target }} was made. It executes no earlier than {{ not_before }}.
If this should not happen, cancel it now:
{{ link }}
{% endblock %}
{% block content %}
<p>Hello {{ name }},</p><p>A break-glass request (<strong>{{ action }}</strong>) for {{ target }} was made. It executes no earlier than {{ not_before }}.</p><p style="margin:24px 0"><a href="{{ link }}" style="background:#7A4E2E;color:#FFFFFF;text-decoration:none;padding:12px 20px;border-radius:2px;display:inline-block;font-weight:600">Cancel this request</a></p>
{% endblock %}
