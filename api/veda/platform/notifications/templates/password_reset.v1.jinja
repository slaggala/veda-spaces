{% extends "_layout.v1.jinja" %}
{% block subject %}Reset your Veda Workspace password{% endblock %}
{% block headline %}Reset your password{% endblock %}
{% block text %}
Hello {{ name }},

Use this link to set a new password. It expires in 30 minutes:
{{ link }}

If you didn't ask for this, ignore this email; your password is unchanged.
{% endblock %}
{% block content %}
<p>Hello {{ name }},</p><p>Use the button below to set a new password. The link expires in 30 minutes.</p><p style="margin:24px 0"><a href="{{ link }}" style="background:#7A4E2E;color:#FFFFFF;text-decoration:none;padding:12px 20px;border-radius:2px;display:inline-block;font-weight:600">Set a new password</a></p><p style="color:#5D574F;font-size:13px">If you didn't ask for this, ignore this email; your password is unchanged.</p>
{% endblock %}
